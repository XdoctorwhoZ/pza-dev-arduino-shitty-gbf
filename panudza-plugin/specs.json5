{
    name: "arduino-shitty-gbf",

    producers: {
        "arduino-shitty-gbf" : {
            manufacturer: "panduza",
            interface: {
                name: "serial-eol",
                conf: {
                    eol: "\n"
                }
            },

            // classes: {

            // },
            attributes: {
                "signal trigger": {
                    info: "Duration of the signal in ms",
                    type: "trigger",
                    mode: "rw",
                    model: "trigger-accessor",
                    codec: {
                        name: "scpi",
                        conf: {
                            get_query: "SIGnal:TRIG?",
                            set_query: "SIGnal:TRIG"
                        }
                    }
                },
                "signal duration": {
                    info: "Duration of the signal in ms",
                    type: "number",
                    mode: "rw",
                    model: "number-accessor",
                    codec: {
                        name: "scpi",
                        conf: {
                            get_query: "SIGnal:DUR?",
                            set_query: "SIGnal:DUR"
                        }
                    }
                },
                "duty cycle": {
                    info: "Duty cycle of the PWM",
                    type: "number",
                    range: [0, 100],
                    mode: "rw",
                    model: "number-accessor",
                    codec: {
                        name: "scpi",
                        conf: {
                            get_query: "PWM:DUTY?",
                            set_query: "PWM:DUTY"
                        }
                    }
                },
                period: {
                    info: "Period of the PWM in micro-seconds",
                    type: "number",
                    mode: "rw",
                    model: "number-accessor",
                    codec: {
                        name: "scpi",
                        conf: {
                            get_query: "PWM:PERIOD?",
                            set_query: "PWM:PERIOD"
                        }
                    }
                }
            }
        }


    }
}
